# =============================================================================
# AI Personal Life OS - environment variables
#
# Copy to .env.local and fill in. NEVER commit real credentials.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS - used exclusively by the Telegram webhook and the
# cron tick, which resolve the user themselves. Must never be exposed to the
# browser, so it deliberately has no NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider -------------------------------------------------------------
# The app is written against an AIProvider interface: switching model or vendor
# is an environment change, not a code change.
# AI_PROVIDER: gemini | openai-compatible | anthropic
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
# Only needed for openai-compatible providers (Groq, OpenRouter, Ollama, ...)
AI_BASE_URL=

# --- Telegram ----------------------------------------------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Any long random string. Sent by Telegram as X-Telegram-Bot-Api-Secret-Token
# and checked on every webhook request.
TELEGRAM_WEBHOOK_SECRET=
# Second barrier on top of the database link: comma-separated Telegram user ids
# allowed to talk to the bot at all. Leave empty to rely on linking alone.
TELEGRAM_ALLOWED_USER_IDS=

# --- Scheduler ---------------------------------------------------------------
# Shared secret between the GitHub Actions workflow and /api/cron/tick.
# Vercel Hobby crons only fire once a day, so scheduling lives in GitHub Actions.
CRON_SECRET=

# --- App ---------------------------------------------------------------------
# Public base url, used to register the Telegram webhook and build links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
